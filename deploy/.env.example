POSTGRES_DB=vpsman
POSTGRES_USER=vpsman
# Used both by the postgres container and the API/worker connection URL.
# Use URL-safe random text, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replacewithrandomhexpostgrespassword

# Compose mounts ./config to /etc/vpsman and sets VPSMAN_SUITE_CONFIG to
# /etc/vpsman/vpsman.toml. The API can replace that authoritative TOML through
# the dashboard. Secret files are mounted per service under /run/secrets so
# API and worker containers do not receive gateway-only key material.
# Put secret contents in files referenced by the TOML, for example:
# ./config/secrets/vpsman_internal_token
# ./config/secrets/vpsman_gateway_private_key_hex
# ./config/secrets/vpsman_privilege_verifier_key_hex

# Loopback-only defaults. Change these only after reviewing the production
# network-boundary and firewall runbook shipped with the selected release.
# An unqualified gateway mapping such as 59443:9443 publishes on IPv4 and IPv6;
# an explicit 127.0.0.1 host address remains IPv4 loopback-only.
VPSMAN_FRONTEND_BIND=127.0.0.1:5173
VPSMAN_GATEWAY_PUBLISH=127.0.0.1:9443:9443

# Docker retains at most max-file rotated files of max-size for each service.
VPSMAN_DOCKER_LOG_MAX_SIZE=10m
VPSMAN_DOCKER_LOG_MAX_FILES=5

# Dependencies default to warnings; each vpsman service emits informational
# operational events. Override a filter only while troubleshooting.
VPSMAN_API_LOG_FILTER=warn,vpsman_api=info,tower_http=info
VPSMAN_GATEWAY_LOG_FILTER=warn,vpsman_gateway=info
VPSMAN_WORKER_LOG_FILTER=warn,vpsman_worker=info
